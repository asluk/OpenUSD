    rel crs:binding = </CRS/Lambert93>
    double3 crs:position = (648237.125, 6862251.89, 33.79)

    def Mesh "Plane"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-400, -400, -0.1), (400, -400, -0.1), (400, 400, -0.1), (-400, 400, -0.1)]
        color3f[] primvars:displayColor = [(0.63, 0.72, 0.67)]
        uniform token subdivisionScheme = "none"
    }
}

