#usda 1.0
(
    customLayerData = {
        bool geospatialResolutionRequired = 1
    }
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "CRS"
{
    def CoordinateReferenceSystem "Source"
    {
        uniform token crs:wkt = 'GEODCRS["RGF93 v2b",DATUM["Reseau Geodesique Francais 1993 v2b",ELLIPSOID["GRS 1980",6378137,298.257222101,LENGTHUNIT["metre",1]],ID["EPSG",1313]],PRIMEM["Greenwich",0,ANGLEUNIT["degree",0.0174532925199433]],CS[CARTESIAN,3],AXIS["(X)",GEOCENTRICX,ORDER[1],LENGTHUNIT["metre",1]],AXIS["(Y)",GEOCENTRICY,ORDER[2],LENGTHUNIT["metre",1]],AXIS["(Z)",GEOCENTRICZ,ORDER[3],LENGTHUNIT["metre",1]],ID["EPSG",9780]]'
    }
}

