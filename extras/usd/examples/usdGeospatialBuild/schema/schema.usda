#usda 1.0
(subLayers = [@usd/schema.usda@])
over "GLOBAL" (customData = {
    string libraryName = "geospatialCandidate"
    string libraryPrefix = "GeoCandidate"
    bool skipCodeGeneration = true
}) {}
class CoordinateReferenceSystem "CoordinateReferenceSystem" (
    inherits = </Typed>
    doc = "Experimental WKT-authoritative CRS definition; candidate, not an approved standard."
) {
    uniform token crs:wkt
}
class "GeospatialCRSBindingAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        dictionary extraPlugInfo = { string[] impliesCapabilities = ["geospatial:crsResolution"] }
    }
    doc = "Experimental authored binding and placement. Applied USD data schema; no standard callable API proposed."
) {
    double3 crs:position
    quatd crs:orientation = (1,0,0,0)
    double3 crs:scale = (1,1,1)
}
class GeospatialDataSource "GeospatialDataSource" (
    inherits = </Typed>
    customData = { dictionary extraPlugInfo = { string[] impliesCapabilities = ["geospatial:crsResolution"] } }
    doc = "External absolute measurement association in the local candidate; not model placement."
) {
    uniform asset data:asset
    uniform token data:format
    uniform string data:field
    uniform string data:coordinateDomain
}
