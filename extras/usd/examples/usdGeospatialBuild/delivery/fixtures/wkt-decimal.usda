#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    timeCodesPerSecond = 48
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["ClaimsAPI"]
    customData = {
        dictionary profilesInfo = {
            dictionary capabilityUsages = {
                string "usd.geospatial.crsResolution.v1" = "hard"
            }
            dictionary profileCompatibility = {
                token[] "usd.geospatial.publication.v1" = []
            }
        }
        string userDocBrief = "Concrete prim schema for a transform, which implements Xformable."
    }
)
{
    def Xform "Model" (
        apiSchemas = ["GeospatialCRSBindingAPI"]
        prepend references = @./crs-library.usda@</Definitions/Ceceff6d68cb505ed>
    )
    {
        double3 crs:orientation = (-90, 0, 0)
        double3 crs:position = (6378137, 0, 0)
        uniform token crs:wkt = 'GEODCRS["WGS 84",ENSEMBLE["World Geodetic System 1984 ensemble",MEMBER["World Geodetic System 1984 (Transit)"],MEMBER["World Geodetic System 1984 (G730)"],MEMBER["World Geodetic System 1984 (G873)"],MEMBER["World Geodetic System 1984 (G1150)"],MEMBER["World Geodetic System 1984 (G1674)"],MEMBER["World Geodetic System 1984 (G1762)"],MEMBER["World Geodetic System 1984 (G2139)"],MEMBER["World Geodetic System 1984 (G2296)"],ELLIPSOID["WGS 84",6378137,298.257223563,LENGTHUNIT["metre",1.000E0]],ENSEMBLEACCURACY[2]],PRIMEM["Greenwich",0,ANGLEUNIT["degree",0.0174532925199433]],CS[Cartesian,3],AXIS["(X)",geocentricX,ORDER[1],LENGTHUNIT["metre",1.000E0]],AXIS["(Y)",geocentricY,ORDER[2],LENGTHUNIT["metre",1.000E0]],AXIS["(Z)",geocentricZ,ORDER[3],LENGTHUNIT["metre",1.000E0]],USAGE[SCOPE["Geodesy. Navigation and positioning using GPS satellite system."],AREA["World."],BBOX[-90,-180,90,180]],ID["EPSG",4978]]'
        float3 xformOp:scale = (2, 3, 4)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}

