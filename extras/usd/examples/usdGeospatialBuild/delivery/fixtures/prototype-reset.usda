#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    timeCodesPerSecond = 48
    upAxis = "Z"
)

def Xform "World" (
    apiSchemas = ["ClaimsAPI", "GeospatialCRSBindingAPI"]
    customData = {
        dictionary profilesInfo = {
            dictionary capabilityUsages = {
                string "usd.geospatial.crsResolution" = "hard"
            }
        }
        string userDocBrief = "Concrete prim schema for a transform, which implements Xformable."
    }
    prepend references = @./crs-library.usda@</Definitions/Ce51fe9bfc6119195>
)
{
    double3 crs:position = (6378137, 0, 0)

    def Xform "Proto"
    {
        double3 xformOp:translate = (100, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Points "Child"
        {
            point3f[] points = [(0, 0, 0)]
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate"]
        }
    }

    def PointInstancer "Inst"
    {
        point3f[] positions = [(10, 0, 0)]
        int[] protoIndices = [0]
        rel prototypes = </World/Proto>
    }
}

