#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    timeCodesPerSecond = 48
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["ClaimsAPI"]
    customData = {
        dictionary profilesInfo = {
            dictionary capabilityUsages = {
                string "geospatial:crsResolution" = "hard"
            }
        }
        string userDocBrief = "Concrete prim schema for a transform, which implements Xformable."
    }
)
{
    def Xform "Model" (
        apiSchemas = ["GeospatialCRSBindingAPI"]
        prepend references = @./crs-library.usda@</Definitions/Ce51fe9bfc6119195>
    )
    {
        double3 crs:position = (100, 200, 300)
        float xformOp:rotateZ = 90
        double3 xformOp:translate:pivot = (100, 200, 300)
        uniform token[] xformOpOrder = ["xformOp:translate:pivot", "xformOp:rotateZ", "!invert!xformOp:translate:pivot"]
    }
}

