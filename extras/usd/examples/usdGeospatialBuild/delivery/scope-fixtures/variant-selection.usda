#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    apiSchemas = ["GeospatialCRSBindingAPI"]
    variants = {
        string coordinateContext = "Grid"
    }
    prepend variantSets = "coordinateContext"
)
{
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Data"
    {
    }
    variantSet "coordinateContext" = {
        "ECEF" (
            prepend references = @./crs-library.usda@</Definitions/ECEF>
        ) {

        }
        "Grid" (
            prepend references = @./crs-library.usda@</Definitions/Grid>
        ) {

        }
    }
}

