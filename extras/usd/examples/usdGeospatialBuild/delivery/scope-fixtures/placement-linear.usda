#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Model" (
    apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs-library.usda@</Definitions/ECEF>
)
{
    quatd crs:orientation.timeSamples = {
        0: (1, 0, 0, 0),
        10: (0, 0, 0, 1),
    }
    double3 crs:position.timeSamples = {
        0: (0, 0, 1),
        10: (10, 20, 3),
    }
    double3 crs:scale.timeSamples = {
        0: (1, 2, 3),
        10: (3, 4, 5),
    }
    double3 xformOp:translate = (1000, 2000, 3000)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

