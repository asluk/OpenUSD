#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    apiSchemas = ["GeospatialCRSBindingAPI"]
)
{
    custom uniform string crs:wkt = 'GEODCRS["ITRF2020",DYNAMIC[FRAMEEPOCH[2015.0]],DATUM["International Terrestrial Reference Frame 2020",ELLIPSOID["GRS 1980",6378137.0,298.257222101,LENGTHUNIT["metre",1.0]]],PRIMEM["Greenwich",0.0,ANGLEUNIT["degree",0.0174532925199433]],CS[Cartesian,3],AXIS["(X)",geocentricX,ORDER[1],LENGTHUNIT["metre",1.0]],AXIS["(Y)",geocentricY,ORDER[2],LENGTHUNIT["metre",1.0]],AXIS["(Z)",geocentricZ,ORDER[3],LENGTHUNIT["metre",1.0]],ID["EPSG",9990]]'
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Data"
    {
    }
}

