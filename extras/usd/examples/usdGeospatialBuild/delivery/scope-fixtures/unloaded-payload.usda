#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs-library.usda@</Definitions/ECEF>
)
{
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Data"
    {
    }

    def Xform "Payload" (
        prepend payload = @./payload.usda@</Payload>
    )
    {
    }
}

