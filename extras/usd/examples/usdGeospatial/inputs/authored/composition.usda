#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @class.usda@
    ]
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["ClaimsAPI"]
    customData = {
        dictionary profilesInfo = {
            dictionary capabilityUsages = {
                token "usd.geospatial.crsResolution.v1" = "hard"
            }
            dictionary profileCompatibility = {
                token[] "usd.geospatial.publication.v1" = []
            }
        }
    }
    prepend references = @models.usda@
)
{
}

def Xform "Inherited" (
    prepend inherits = </GeoClass>
)
{
    def Mesh "Mesh"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        color3f[] primvars:displayColor = [(0.18, 0.48, 0.63)]
        uniform token subdivisionScheme = "none"
    }
}

def Xform "Offset" (
    prepend references = @models.usda@</World/Moving> (offset = 10; scale = 2)
)
{
}

def Xform "Clip" (
    apiSchemas = ["GeospatialCRSBindingAPI"]
    clips = {
        dictionary default = {
            double2[] active = [(0, 0)]
            asset[] assetPaths = [@clip.usda@]
            string primPath = "/Clip"
            double2[] times = [(0, 0), (2, 2)]
        }
    }
    prepend references = @crs-library.usda@</CRS_b3b282f20dd0>
)
{
    double3 crs:orientation
    double3 crs:position = (2.2945, 48.8584, 70)

    def Mesh "Mesh"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        color3f[] primvars:displayColor = [(0.18, 0.48, 0.63)]
        uniform token subdivisionScheme = "none"
    }
}

