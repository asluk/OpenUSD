#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "NewYork"
    {
        double3 xformOp:translate = (586000, 4515000, 50)
        uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate"]

        def Xform "MoMa"
        {
            double3 xformOp:translate = (-393.7, -337.3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Corner"
            {
                double3 xformOp:translate = (-50, 100, 30)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
    }
}

