#usda 1.0
(
    defaultPrim = "Context"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def CoordinateReferenceSystem "Context" (
    prepend apiSchemas = ["ClaimsAPI"]
    customData = {
        dictionary profilesInfo = {
            dictionary capabilityUsages = {
            }
            dictionary profileCompatibility = {
                string[] "usd.geospatial.publication.v1" = []
            }
        }
    }
)
{
    uniform token crs:wkt = 'GEODCRS["WGS 84",ENSEMBLE["World Geodetic System 1984 ensemble",MEMBER["World Geodetic System 1984 (Transit)"],MEMBER["World Geodetic System 1984 (G730)"],MEMBER["World Geodetic System 1984 (G873)"],MEMBER["World Geodetic System 1984 (G1150)"],MEMBER["World Geodetic System 1984 (G1674)"],MEMBER["World Geodetic System 1984 (G1762)"],MEMBER["World Geodetic System 1984 (G2139)"],MEMBER["World Geodetic System 1984 (G2296)"],ELLIPSOID["WGS 84",6378137,298.257223563,LENGTHUNIT["metre",1]],ENSEMBLEACCURACY[2]],PRIMEM["Greenwich",0,ANGLEUNIT["degree",0.0174532925199433]],CS[Cartesian,3],AXIS["(X)",geocentricX,ORDER[1],LENGTHUNIT["metre",1]],AXIS["(Y)",geocentricY,ORDER[2],LENGTHUNIT["metre",1]],AXIS["(Z)",geocentricZ,ORDER[3],LENGTHUNIT["metre",1]],USAGE[SCOPE["Geodesy. Navigation and positioning using GPS satellite system."],AREA["World."],BBOX[-90,-180,90,180]],ID["EPSG",4978]]'

    def Xform "Origin"
    {
        double3 xformOp:translate = (6378137, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Mesh0" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(0, 0, 0), (9.313226e-10, 1, 1)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            rel material:binding = </Context/Materials/Material0>
            normal3f[] normals = [(1, 0, 0), (1, -4.656613e-8, 0), (1, 0, 0)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(0, 0, 0), (0, 1, 0), (9.313226e-10, 0, 1)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate:resolvedOffset = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate:resolvedOffset"]
        }
    }

    def Scope "Materials"
    {
        def Material "Material0"
        {
            token outputs:surface.connect = </Context/Materials/Material0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.3, 0.4)
                token outputs:surface
            }
        }
    }
}

